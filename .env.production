# Production-only overrides. Loaded automatically by `next build` (NODE_ENV=production)
# and merged on top of `.env`, so local `npm run dev` keeps using localhost.
#
# This MUST point at the live backend. If it is missing/wrong, the browser falls
# back to bundled MOCK_PRODUCTS (stale Unsplash images) — which is the "same old
# images no matter how many redeploys" bug.
NEXT_PUBLIC_API_URL=https://backendapis.thesboxx.com
